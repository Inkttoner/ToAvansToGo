@model IEnumerable<Package>
@{
    ViewData["Title"] = "My canteen";
    var canteen = (Canteen)ViewData["Canteen"]!;
}

<div class="page-header">
    <div>
        <h1>Packages at @canteen.Location</h1>
        <p>@canteen.City.ToDisplayName(). Reserved packages are shown here too.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New package</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2 class="h5">There are no packages yet</h2>
        <p>Create the first package so students can reserve it.</p>
        <a class="btn btn-primary" asp-action="Create">New package</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var package in Model)
        {
            <div class="col">
                <partial name="_PackageCard" model="package" />
            </div>
        }
    </div>
}
