@model PackageFormViewModel
@{
    ViewData["Title"] = "Edit package";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id">Back to the package</a>
        <h1 class="mt-2">Edit package</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel">
    <input type="hidden" asp-for="Id" />
    <partial name="_PackageFields" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>
