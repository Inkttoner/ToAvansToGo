@model PackageFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="TypeOfMeal" class="form-label"></label>
        <select asp-for="TypeOfMeal" asp-items="Html.GetEnumSelectList<MealType>()" class="form-select"></select>
        <span asp-validation-for="TypeOfMeal" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PickUpTime" class="form-label"></label>
        <input asp-for="PickUpTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="PickUpTime" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AvailableTill" class="form-label"></label>
        <input asp-for="AvailableTill" type="datetime-local" class="form-control" />
        <span asp-validation-for="AvailableTill" class="text-danger"></span>
    </div>

    <div class="col-12">
        <span class="form-label d-block">Products</span>
        @foreach (var product in Model.AllProducts)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedProductIds"
                       value="@product.Id" id="product-@product.Id"
                       @(Model.SelectedProductIds.Contains(product.Id) ? "checked" : "") />
                <label class="form-check-label" for="product-@product.Id">
                    <img class="product-check__photo" src="~/images/products/@product.Picture" alt="" />
                    @product.Name
                    @if (product.HasAlcohol)
                    {
                        <span class="tag tag-accent-2 ms-1">Contains alcohol</span>
                    }
                </label>
            </div>
        }
        <span asp-validation-for="SelectedProductIds" class="text-danger"></span>
    </div>
</div>
